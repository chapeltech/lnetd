# Maintainer: ChapelTech <packages@chapel.tech>
pkgname=lnetd
pkgver=0.3
pkgrel=0
pkgdesc="Lightweight inetd-style UNIX socket listener"
url="https://github.com/ChapelTech/lnetd"
arch="all"
license="MIT"
makedepends="groff"
checkdepends="python3 util-linux-misc"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar"

build() {
	make \
		CFLAGS="$CFLAGS" \
		CPPFLAGS="$CPPFLAGS" \
		LDFLAGS="$LDFLAGS" \
		NROFF=/usr/bin/nroff
}

check() {
	make check
}

package() {
	install -Dm755 lnetd "$pkgdir/usr/sbin/lnetd"
	install -Dm644 lnetd.8 "$pkgdir/usr/share/man/man8/lnetd.8"
}

# Populated by packaging/ci/build-alpine after creating the tagged archive.
sha512sums=""
