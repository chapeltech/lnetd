#!/bin/sh

set -eu

: "${RELEASE_TAG:?RELEASE_TAG must be set}"
: "${TARGET_ARCHITECTURE:?TARGET_ARCHITECTURE must be set}"
: "${SOURCE_DIR:?SOURCE_DIR must be set}"
: "${PACKAGING_DIR:?PACKAGING_DIR must be set}"
: "${ARTIFACT_DIR:?ARTIFACT_DIR must be set}"

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
	build-essential debhelper groff-base python3 util-linux

test "$(dpkg --print-architecture)" = "$TARGET_ARCHITECTURE"
git config --global --add safe.directory "$SOURCE_DIR"
tag_commit=$(git -C "$SOURCE_DIR" rev-parse --verify \
	"refs/tags/$RELEASE_TAG^{commit}")
test "$(git -C "$SOURCE_DIR" rev-parse --verify 'HEAD^{commit}')" = \
	"$tag_commit"

build_dir=$(mktemp -d)
cleanup()
{
	rm -rf "$build_dir"
}
trap cleanup EXIT HUP INT TERM

source_tree=$build_dir/source
mkdir "$source_tree"
git -C "$SOURCE_DIR" archive --format=tar "$tag_commit" |
	tar -x -C "$source_tree"
rm -rf "$source_tree/debian"
cp -a "$PACKAGING_DIR/debian" "$source_tree/"

package_version=$(dpkg-parsechangelog \
	--file "$source_tree/debian/changelog" -S Version)
test "${RELEASE_TAG#v}" = "${package_version%%-*}"
test "${package_version#*-}" = 2

(cd "$source_tree" && dpkg-buildpackage --build=binary --no-sign)

mkdir -p "$ARTIFACT_DIR"
found=false
for package in "$build_dir"/*.deb; do
	[ -f "$package" ] || continue
	found=true
	test "$(dpkg-deb -f "$package" Architecture)" = \
		"$TARGET_ARCHITECTURE"
	cp "$package" "$ARTIFACT_DIR/"
done
test "$found" = true
