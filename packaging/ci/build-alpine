#!/bin/sh

set -eu

: "${RELEASE_TAG:?RELEASE_TAG must be set}"
: "${TARGET_ARCHITECTURE:?TARGET_ARCHITECTURE must be set}"
: "${SOURCE_DIR:?SOURCE_DIR must be set}"
: "${PACKAGING_DIR:?PACKAGING_DIR must be set}"
: "${ARTIFACT_DIR:?ARTIFACT_DIR must be set}"

apk add --no-cache \
	alpine-sdk apkbuild-lint groff python3 util-linux-misc

case "$TARGET_ARCHITECTURE" in
	x86_64|aarch64) ;;
	*)
		echo "unsupported target architecture: $TARGET_ARCHITECTURE" >&2
		exit 1
		;;
esac
test "$(uname -m)" = "$TARGET_ARCHITECTURE"
test "$(apk --print-arch)" = "$TARGET_ARCHITECTURE"

git config --global --add safe.directory "$SOURCE_DIR"
tag_commit=$(git -C "$SOURCE_DIR" rev-parse --verify \
	"refs/tags/$RELEASE_TAG^{commit}")
test "$(git -C "$SOURCE_DIR" rev-parse --verify 'HEAD^{commit}')" = \
	"$tag_commit"

apkbuild=$PACKAGING_DIR/packaging/alpine/APKBUILD
test -f "$apkbuild"
package_metadata=$(sh -eu -c '
	. "$1"
	printf "%s\n%s\n%s\n" "$pkgname" "$pkgver" "$pkgrel"
' sh "$apkbuild")
package_name=$(printf '%s\n' "$package_metadata" | sed -n '1p')
package_version=$(printf '%s\n' "$package_metadata" | sed -n '2p')
package_revision=$(printf '%s\n' "$package_metadata" | sed -n '3p')
test "$package_name" = lnetd
test "${RELEASE_TAG#v}" = "$package_version"
case "$package_revision" in
	''|*[!0-9]*)
		echo "invalid Alpine package revision: $package_revision" >&2
		exit 1
		;;
esac
apk version --check "$package_version-r$package_revision"

build_dir=$(mktemp -d)
disposable_public_key=
cleanup()
{
	if [ -n "$disposable_public_key" ]; then
		rm -f "$disposable_public_key"
	fi
	rm -rf "$build_dir"
}
trap cleanup EXIT HUP INT TERM

package_dir=$build_dir/package/$package_name
repository_dir=$build_dir/repository
abuild_home=$build_dir/abuild-home
mkdir -p "$package_dir" "$repository_dir" "$abuild_home"
cp "$apkbuild" "$package_dir/APKBUILD"
git -C "$SOURCE_DIR" archive --format=tar \
	--prefix="$package_name-$package_version/" "$tag_commit" \
	>"$package_dir/$package_name-$package_version.tar"

apkbuild-lint "$package_dir/APKBUILD"
if [ -n "${PACKAGER_PRIVKEY:-}" ]; then
	test -f "$PACKAGER_PRIVKEY"
else
	HOME="$abuild_home" abuild-keygen -a -n
	# shellcheck disable=SC1091 # Generated by abuild-keygen.
	. "$abuild_home/.abuild/abuild.conf"
	export PACKAGER_PRIVKEY
	disposable_public_key=/etc/apk/keys/$(basename "$PACKAGER_PRIVKEY").pub
	install -Dm644 "$PACKAGER_PRIVKEY.pub" "$disposable_public_key"
fi
HOME="$abuild_home" abuild -F -C "$package_dir" validate
HOME="$abuild_home" abuild -F -C "$package_dir" -P "$repository_dir"

package_path=$repository_dir/package/$TARGET_ARCHITECTURE
main_package=$package_path/$package_name-$package_version-r$package_revision.apk
test -f "$main_package"

mkdir -p "$ARTIFACT_DIR"
found=false
for package in "$package_path"/*.apk; do
	[ -f "$package" ] || continue
	found=true
	apk verify "$package"
	cp "$package" "$ARTIFACT_DIR/"
done
test "$found" = true
